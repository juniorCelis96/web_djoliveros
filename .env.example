# Copiar como .env.local (desarrollo) y configurar las mismas variables en Vercel.
# Mientras una integración no tenga sus variables, el sitio la ejecuta en modo simulación.

NEXT_PUBLIC_SITE_URL=https://www.davidjoliveros.com

# Correo que recibe los mensajes de contacto y avisos de nuevos suscriptores
CONTACT_TO_EMAIL=

# SMTP (Gmail, Outlook, Zoho, SendGrid SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="David J. Oliveros <no-reply@davidjoliveros.com>"

# Supabase (Project Settings > API). La service role key es solo para el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets vía Google Apps Script (Web App con doPost que agrega filas)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
